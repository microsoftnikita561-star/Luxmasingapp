{
  "name": "lux-browser",
  "productName": "LuxBrowser",
  "version": "1.0.0",
  "description": "Лёгкий приватный браузер на движке Chromium",
  "main": "src/main.js",
  "type": "commonjs",
  "license": "MIT",
  "author": "LuxBrowser",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.3"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "app.luxbrowser",
    "productName": "LuxBrowser",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["src/**/*", "package.json"],
    "win": { "target": ["nsis", "portable"], "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "linux": { "target": ["AppImage"], "category": "Network", "icon": "build/icon.png" },
    "mac": { "target": ["dmg"], "category": "public.app-category.productivity", "icon": "build/icon.png" }
  }
}
